    D -->|是| F["复查分区<br/>调用客户端重排"]
    F --> G["重新读取<br/>验证结果后退出"]
    classDef service fill:#e8f0fe,stroke:#547ac4,color:#172b4d
    classDef storage fill:#e6f5ef,stroke:#4b9b7e,color:#153c2e
